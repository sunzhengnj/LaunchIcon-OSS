{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "开机登录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at Login"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开机登录"
          }
        }
      }
    },
    "显示菜单栏图标": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Menu Bar Icon"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示菜单栏图标"
          }
        }
      }
    },
    "启动应用后自动收起": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide After Opening an App"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动应用后自动收起"
          }
        }
      }
    },
    "减少动态效果（合并只保留短淡入）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce Motion (short fade for merges)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少动态效果（合并只保留短淡入）"
          }
        }
      }
    },
    "恢复": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复"
          }
        }
      }
    },
    "重新扫描": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rescan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新扫描"
          }
        }
      }
    },
    "LaunchIcon 设置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LaunchIcon Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LaunchIcon 设置"
          }
        }
      }
    },
    "重新扫描完成": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rescan complete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新扫描完成"
          }
        }
      }
    },
    "扫描仍不完整，暂时无法整理": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan is still incomplete; organizing is unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描仍不完整，暂时无法整理"
          }
        }
      }
    },
    "通用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通用"
          }
        }
      }
    },
    "未知": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知"
          }
        }
      }
    },
    "开发构建": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Development build"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发构建"
          }
        }
      }
    },
    "呼出快捷键": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launcher Shortcut"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "呼出快捷键"
          }
        }
      }
    },
    "关闭后仍可用快捷键呼出；从启动器顶部设置按钮或按 Command-逗号可再次打开设置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shortcut still opens LaunchIcon. Open Settings from the launcher or press Command-Comma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后仍可用快捷键呼出；从启动器顶部设置按钮或按 Command-逗号可再次打开设置"
          }
        }
      }
    },
    "减少动态效果": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce Motion"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少动态效果"
          }
        }
      }
    },
    "开启后不播放合并图标飞入与文件夹弹跳，只保留短淡入；关闭可恢复完整过渡。macOS 系统的减少动态效果设置仍会优先生效": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replaces merge flights and folder springs with short fades. The macOS Reduce Motion setting also applies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后不播放合并图标飞入与文件夹弹跳，只保留短淡入；关闭可恢复完整过渡。macOS 系统的减少动态效果设置仍会优先生效"
          }
        }
      }
    },
    "关闭此项可显示完整合并过渡动画；系统减少动态效果开启时仍会简化动画": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off to show full merge transitions. macOS Reduce Motion may still simplify them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此项可显示完整合并过渡动画；系统减少动态效果开启时仍会简化动画"
          }
        }
      }
    },
    "打开系统登录项设置…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Login Items Settings…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统登录项设置…"
          }
        }
      }
    },
    "隐藏的应用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden Apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏的应用"
          }
        }
      }
    },
    "重新扫描 Applications 文件夹": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rescan Applications folders"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新扫描 Applications 文件夹"
          }
        }
      }
    },
    "没有隐藏的应用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No hidden apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有隐藏的应用"
          }
        }
      }
    },
    "正在重新扫描": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rescanning…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重新扫描"
          }
        }
      }
    },
    "设置已应用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings applied"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置已应用"
          }
        }
      }
    },
    "请在系统设置的登录项中允许 LaunchIcon。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow LaunchIcon in System Settings > Login Items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置的登录项中允许 LaunchIcon。"
          }
        }
      }
    },
    "开机登录设置已更新": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Login item updated"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开机登录设置已更新"
          }
        }
      }
    },
    "当前无法恢复该应用，请等待扫描完成后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't restore this app yet. Try again after the scan finishes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前无法恢复该应用，请等待扫描完成后重试。"
          }
        }
      }
    },
    "已恢复应用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App restored"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已恢复应用"
          }
        }
      }
    },
    "设置…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置…"
          }
        }
      }
    },
    "退出 LaunchIcon": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit LaunchIcon"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 LaunchIcon"
          }
        }
      }
    },
    "编辑": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑"
          }
        }
      }
    },
    "全选": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select All"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全选"
          }
        }
      }
    },
    "显示 LaunchIcon": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show LaunchIcon"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示 LaunchIcon"
          }
        }
      }
    },
    "隐藏 LaunchIcon": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide LaunchIcon"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏 LaunchIcon"
          }
        }
      }
    },
    "退出": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出"
          }
        }
      }
    },
    "正在扫描应用，暂时无法整理": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning apps; organizing is unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在扫描应用，暂时无法整理"
          }
        }
      }
    },
    "应用扫描已取消，请重新扫描": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App scan was cancelled. Rescan to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用扫描已取消，请重新扫描"
          }
        }
      }
    },
    "布局文件无法读取，暂时无法整理；原文件已保留": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't read the layout. Organizing is unavailable; the original file was kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "布局文件无法读取，暂时无法整理；原文件已保留"
          }
        }
      }
    },
    "应用扫描不完整，暂时无法整理；请重新扫描": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App scan is incomplete. Rescan before organizing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用扫描不完整，暂时无法整理；请重新扫描"
          }
        }
      }
    },
    "正在显示上次应用列表；重新扫描后可整理": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing the last app list. Rescan to organize."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在显示上次应用列表；重新扫描后可整理"
          }
        }
      }
    },
    "使用上次应用列表": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Last App List"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用上次应用列表"
          }
        }
      }
    },
    "正在准备应用…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing apps…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备应用…"
          }
        }
      }
    },
    "未找到可用的应用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No available apps found"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到可用的应用"
          }
        }
      }
    },
    "请确认应用位于 Applications 文件夹，然后重新扫描。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure apps are in an Applications folder, then rescan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认应用位于 Applications 文件夹，然后重新扫描。"
          }
        }
      }
    },
    "拖拽整理": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to organize"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖拽整理"
          }
        }
      }
    },
    "上一页": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous Page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一页"
          }
        }
      }
    },
    "下一页": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next Page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一页"
          }
        }
      }
    },
    "搜索应用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search Apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索应用"
          }
        }
      }
    },
    "按应用名称或 Bundle ID 搜索": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search by app name or Bundle ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按应用名称或 Bundle ID 搜索"
          }
        }
      }
    },
    "设置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "打开 LaunchIcon 设置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open LaunchIcon Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 LaunchIcon 设置"
          }
        }
      }
    },
    "重新扫描应用并恢复可整理的列表": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rescan apps to restore organizing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新扫描应用并恢复可整理的列表"
          }
        }
      }
    },
    "使用本机上次完整扫描的应用列表；整理功能暂不可用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the last complete app list on this Mac; organizing is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用本机上次完整扫描的应用列表；整理功能暂不可用"
          }
        }
      }
    },
    "取消当前扫描，使用本机上次完整扫描的应用列表；整理功能暂不可用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel the scan and use the last complete app list; organizing is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消当前扫描，使用本机上次完整扫描的应用列表；整理功能暂不可用"
          }
        }
      }
    },
    "重新扫描标准 Applications 文件夹": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rescan standard Applications folders"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新扫描标准 Applications 文件夹"
          }
        }
      }
    },
    "关闭提示": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss Message"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭提示"
          }
        }
      }
    },
    "应用列表正在加载或不完整，暂时无法整理": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App list is loading or incomplete; organizing is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用列表正在加载或不完整，暂时无法整理"
          }
        }
      }
    },
    "拖动应用以整理布局": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag apps to organize the layout"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动应用以整理布局"
          }
        }
      }
    },
    "布局未保存，请检查磁盘空间或文件权限": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Layout wasn't saved. Check disk space and file permissions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "布局未保存，请检查磁盘空间或文件权限"
          }
        }
      }
    },
    "扫描已取消": {
      "localizations": {
        "en": {
          "stringUnit": {
